# =============================================================================
# Tablecraft — Environment Variables (copy to .env.local, do NOT commit real values)
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (keep OUT of NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
ORDER_VIEW_SECRET=random-string-for-hmac-signing

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Tablecraft AI models ---
# Haiku 5.5 — build (medium effort) + chatbot/scan/vision (low effort)
# POST https://api.anthropic.com/v1/messages { model: "claude-haiku-5-5", output_config: { effort: "low"|"medium" } }
CLAUDE_API=your-claude-api-key-here
# GPT 6.1 Sol (medium effort) — combine + edit (code read/write)
# POST https://api.openai.com/v1/responses { model: "gpt-6.1-sol", reasoning: { effort: "medium" } }
OPENAI_API=your-openai-api-key-here
# Image generation (OpenAI GPT Image 2.5 via the same OPENAI_API key)
# Optional base-URL override; defaults to https://api.openai.com/v1 when unset.
# IMAGE_API=https://api.openai.com/v1

# --- Email (optional, required for 75% quota mails) ---
# Quota warnings go to the owner address; without a verified Resend domain
# only the Resend account owner's inbox is reliably reachable.
RESEND_API_KEY=re_xxx
# Gmail delivery: onboarding@resend.dev only reaches the Resend account owner.
# Verify your domain in Resend, then set e.g. Tablecraft <noreply@yourdomain.com>.
RESEND_FROM_EMAIL=Tablecraft <onboarding@resend.dev>

# --- Custom domains (Vercel Domains API) ---
# Server-only. Create a token with project/domain access; never expose it.
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxx
# Optional: set when the project belongs to a team.
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxx
# Optional DNS defaults shown in the Launch page (Vercel may return different values).
VERCEL_DNS_A_RECORD=76.76.21.21
VERCEL_DNS_CNAME=cname.vercel-dns.com

# --- Admin Guard ---
REVIEW_GATE_KEY=your-random-admin-key
