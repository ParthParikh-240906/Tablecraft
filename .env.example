# =============================================================================
# Tablecraft — Environment Variables (copy to .env.local, do NOT commit real values)
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (keep OUT of NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
ORDER_VIEW_SECRET=random-string-for-hmac-signing

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Agnes AI (used for menu scan, chatbot, content gen, vision parse) ---
AGNES_API_KEY=your-agnes-api-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_API_URL=https://apihub.agnes-ai.com/v1/images/generations

# --- Email (optional) ---
RESEND_API_KEY=re_xxx

# --- Admin Guard ---
REVIEW_GATE_KEY=your-random-admin-key
