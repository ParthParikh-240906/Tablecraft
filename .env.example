# --- Supabase (anon key only in browser; service role only server-side, never in NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (keep OUT of NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Price IDs — create products in Stripe Dashboard and paste IDs here
STRIPE_PRICE_ID_PRO=price_PRO_id_here
STRIPE_PRICE_ID_MAX=price_MAX_id_here

# --- Groq (AI theming for signup) ---
# Optional: if not set, AI theming falls back to default theme
